{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w apps/web",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://nimbus-api-h5sj.onrender.com/api/:path*" },
    { "source": "/oauth/:path*", "destination": "https://nimbus-api-h5sj.onrender.com/oauth/:path*" },
    { "source": "/public/:path*", "destination": "https://nimbus-api-h5sj.onrender.com/public/:path*" },
    { "source": "/hooks/:path*", "destination": "https://nimbus-api-h5sj.onrender.com/hooks/:path*" },
    { "source": "/stripe/:path*", "destination": "https://nimbus-api-h5sj.onrender.com/stripe/:path*" },
    { "source": "/sf/:path*", "destination": "https://nimbus-api-h5sj.onrender.com/sf/:path*" },
    { "source": "/health", "destination": "https://nimbus-api-h5sj.onrender.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
