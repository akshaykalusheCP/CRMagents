PORT=3101
PUBLIC_URL=http://localhost:3101
DATABASE_URL=postgres://crm:crm@localhost:5444/crmagents
# 32 bytes hex: openssl rand -hex 32
TOKEN_ENC_KEY=
# Salesforce External Client App (Connected App) credentials
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_LOGIN_URL=https://login.salesforce.com
ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5
# Public URL Salesforce uses to call the platform (e.g. an ngrok tunnel in dev)
BRIDGE_URL=

# Emails from CRMagents (invitations, password resets, alerts). Optional: without it, mail goes out through the
# workspace's connected Salesforce org, and admins can always copy invite/reset links.
RESEND_API_KEY=
MAIL_FROM="CRMagents <noreply@yourdomain.com>"
# Text messages are set per workspace in Settings (Twilio Account SID, auth token, numbers); these are platform defaults.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# CRMagents staff who can set any workspace's plan (comma-separated emails).
PLATFORM_ADMINS=

# Online payment (Stripe). Leave empty to keep checkout off; staff then set plans in Super admin.
# Webhook endpoint to add in Stripe: <PUBLIC_URL>/stripe/webhook (events: checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.paid, invoice.payment_failed, charge.refunded).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
